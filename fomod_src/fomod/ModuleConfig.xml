<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>NPC Pathing NG 3.0.0</moduleName>

  <!-- One installer, no pages. Everything that depends on what else is installed is decided here
       (file patterns) or at game start (the DLL detects SkyParkour, EVG Animated Traversal,
       Fluid Motion, FluidMotionNPC and NpcTraversalNG by itself, see README "Compatibility").
       The only hard requirements are SKSE and Address Library, neither of which is a plugin
       file, so they cannot be probed here. -->

  <!-- Always installed: plugin, SEQ, MCM config, settings INI and the SKSE DLL. -->
  <requiredInstallFiles>
    <folder source="core" destination="" priority="0"/>
  </requiredInstallFiles>

  <conditionalFileInstalls>
    <patterns>
      <!-- StepUpOnto SKSE present: ship the SkyParkour-aware build of its DLL (same settings,
           same INI; it only stays hands-off while a SkyParkour move is running). Without
           StepUpOnto nothing is installed. If your mod manager cannot see non-plugin files
           and skips this, extras/StepUpOntoSKSE_patch holds the same DLL for a manual copy. -->
      <pattern>
        <dependencies operator="And">
          <fileDependency file="SKSE\Plugins\StepUpOntoSKSE.dll" state="Active"/>
        </dependencies>
        <files>
          <folder source="patch_stepuponto" destination="" priority="1"/>
        </files>
      </pattern>
    </patterns>
  </conditionalFileInstalls>
</config>
